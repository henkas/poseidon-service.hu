---
import { getThemeBootstrapScript, THEME_STORAGE_KEY } from "../lib/theme";

interface Props {
  lang: string;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteOrigin)} />
    <link rel="alternate" hreflang="hu" href={new URL("/", siteOrigin)} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", siteOrigin)} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", siteOrigin)} />
    <script is:inline set:html={getThemeBootstrapScript()} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline set:html={`
      (() => {
        const storageKey = ${JSON.stringify(THEME_STORAGE_KEY)};

        document.querySelectorAll("[data-theme-value]").forEach((button) => {
          button.addEventListener("click", () => {
            const theme = button.dataset.themeValue;

            if (!theme) {
              return;
            }

            try {
              localStorage.setItem(storageKey, theme);
            } catch (_error) {
              // Ignore storage failures and still apply the selected theme.
            }

            document.documentElement.dataset.theme = theme;
          });
        });
      })();
    `} />
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap");
  @import "../styles/tokens.css";
  @import "../styles/global.css";
</style>
