---
import type { LocaleContent } from "../../data/site";
import { localeCookieValue } from "../../lib/locale-routing";

interface Props {
  content: LocaleContent;
}

const { content } = Astro.props;

const items = content.languageSwitch.map((item) => {
  const targetLocale = item.href.startsWith("/en") ? "en" : "hu";

  return {
    ...item,
    cookieValue: localeCookieValue(targetLocale)
  };
});

const activeIndex = Math.max(
  items.findIndex((item) => item.active),
  0
);
---

<div
  class="lang-switcher lang-switcher-enhanced"
  role="group"
  aria-label={content.languageLabel}
  style={`--switcher-count: ${items.length}; --switcher-active: ${activeIndex};`}
>
  <span class="lang-switcher-pill" aria-hidden="true"></span>

  {items.map((item) => (
    <a
      class:list={["lang-link", { active: item.active }]}
      href={item.href}
      data-locale-cookie={item.cookieValue}
      data-locale-switch-link
    >
      {item.label}
    </a>
  ))}
</div>

<script>
  const localeSwitchLinks = document.querySelectorAll<HTMLAnchorElement>("[data-locale-switch-link]");

  localeSwitchLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      if (!(event instanceof MouseEvent)) {
        return;
      }

      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      const href = link.getAttribute("href");
      const cookieValue = link.getAttribute("data-locale-cookie");

      if (!href || !cookieValue) {
        return;
      }

      event.preventDefault();
      document.cookie = cookieValue;
      window.location.assign(href);
    });
  });
</script>

<style>
  .lang-switcher-enhanced {
    position: relative;
    display: inline-grid;
    grid-template-columns: repeat(var(--switcher-count), minmax(0, 1fr));
    gap: 0;
    min-width: 110px;
  }

  .lang-switcher-enhanced .lang-link {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .lang-switcher-enhanced .lang-link.active {
    background: transparent;
    box-shadow: none;
  }

  .lang-switcher-enhanced .lang-switcher-pill {
    position: absolute;
    top: 0.375rem;
    bottom: 0.375rem;
    left: 0.375rem;
    width: calc((100% - 0.75rem) / var(--switcher-count));
    border-radius: var(--radius-pill);
    background: var(--toggle-pill);
    box-shadow: var(--toggle-shadow);
    transform: translateX(calc(100% * var(--switcher-active)));
    transition: transform var(--motion-base);
  }
</style>
