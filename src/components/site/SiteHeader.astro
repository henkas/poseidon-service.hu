---
import type { Locale, LocaleContent } from "../../data/site";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";

interface Props {
  locale: Locale;
  content: LocaleContent;
}

const { locale, content } = Astro.props;

const brandHref = locale === "hu" ? "/" : "/en/";
const brandTagline =
  locale === "hu" ? "Professzionális takarítás" : "Professional cleaning services";
const navigationLabel = locale === "hu" ? "Fő navigáció" : "Main navigation";
const menuLabel = locale === "hu" ? "Menü" : "Menu";
---

<header class="site-header">
  <div class="brand-block">
    <a class="brand" href={brandHref}>
      <span class="brand-mark">PS</span>
      <span>
        <strong>Poseidon Service Kft.</strong>
        <small>{brandTagline}</small>
      </span>
    </a>
  </div>

  <nav class="main-nav site-header-nav" aria-label={navigationLabel}>
    {content.nav.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>

  <div class="site-header-controls site-header-desktop-controls">
    <LanguageSwitcher content={content} />
    <ThemeSwitcher content={content} />
  </div>

  <details class="site-header-mobile-menu">
    <summary class="button button-secondary site-header-mobile-trigger">{menuLabel}</summary>
    <div class="site-header-mobile-panel">
      <nav class="site-header-mobile-nav" aria-label={navigationLabel}>
        {content.nav.map((item) => (
          <a href={item.href} data-mobile-menu-link>{item.label}</a>
        ))}
      </nav>

      <div class="site-header-mobile-controls">
        <LanguageSwitcher content={content} />
        <ThemeSwitcher content={content} />
      </div>
    </div>
  </details>
</header>

<script>
  const mobileMenus = document.querySelectorAll<HTMLDetailsElement>(".site-header-mobile-menu");

  mobileMenus.forEach((menu) => {
    const links = menu.querySelectorAll<HTMLAnchorElement>("[data-mobile-menu-link]");

    links.forEach((link) => {
      link.addEventListener("click", () => {
        menu.removeAttribute("open");
      });
    });
  });
</script>

<style>
  .site-header-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .site-header-mobile-menu {
    display: none;
    width: 100%;
  }

  .site-header-mobile-trigger {
    width: 100%;
    justify-content: center;
    list-style: none;
    cursor: pointer;
  }

  .site-header-mobile-trigger::-webkit-details-marker {
    display: none;
  }

  .site-header-mobile-panel {
    display: grid;
    gap: 1rem;
    margin-top: 0.75rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--header-bg) 84%, transparent);
    border: 1px solid var(--header-border);
    box-shadow: var(--header-shadow);
  }

  .site-header-mobile-nav {
    display: grid;
    gap: 0.625rem;
  }

  .site-header-mobile-nav a {
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-xs);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .site-header-mobile-controls {
    display: grid;
    gap: 0.75rem;
  }

  .site-header-mobile-controls :global(.lang-switcher),
  .site-header-mobile-controls :global(.theme-switcher) {
    width: 100%;
  }

  .site-header-mobile-controls :global(.theme-switcher) {
    justify-content: stretch;
  }

  .site-header-mobile-controls :global(.theme-switcher-button) {
    flex: 1;
  }

  @media (max-width: 760px) {
    .site-header-nav,
    .site-header-controls {
      display: none;
    }

    .site-header-mobile-menu {
      display: block;
    }
  }
</style>
