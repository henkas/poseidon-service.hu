---
import type { LocaleContent } from "../../data/site";

interface Props {
  content: LocaleContent;
}

const { content } = Astro.props;
---

<section class="section trust-strip" aria-label={content.trustStrip.kicker}>
  <div class="section-heading">
    <p class="eyebrow">{content.trustStrip.kicker}</p>
  </div>

  <ul class="trust-strip-items" role="list">
    {content.trustStrip.items.map((item) => (
      <li class="stat-card trust-strip-item">{item}</li>
    ))}
  </ul>
</section>

<style>
  .trust-strip-items {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .trust-strip-item {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }
</style>
