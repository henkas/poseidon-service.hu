---
import type { LocaleContent } from "../../data/site";

interface Props {
  content: LocaleContent;
  id: string;
}

const { content, id } = Astro.props;
const serviceColumnLabel = content.lang === "hu" ? "Szolgáltatás" : "Service";
const priceColumnLabel = content.lang === "hu" ? "Ár" : "Price";
---

<section class="section pricing-section" id={id}>
  <div class="section-heading">
    <p class="eyebrow">{content.pricing.kicker}</p>
    <h2>{content.pricing.title}</h2>
    <p>{content.pricing.note}</p>
  </div>

  <div class="pricing-table-wrap">
    <table class="pricing-table">
      <thead>
        <tr>
          <th>{serviceColumnLabel}</th>
          <th>{priceColumnLabel}</th>
        </tr>
      </thead>
      <tbody>
        {content.pricing.rows.map((row) => (
          <tr>
            <td>{row.service}</td>
            <td>{row.price}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
