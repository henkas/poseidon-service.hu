---
import type { LocaleContent } from "../../data/site";

interface Props {
  content: LocaleContent;
}

const { content } = Astro.props;
---

<section class="section partner-section">
  <div class="section-heading">
    <p class="eyebrow">{content.partnerCompany.kicker}</p>
    <h2>{content.partnerCompany.title}</h2>
    <p>{content.partnerCompany.intro}</p>
  </div>

  <article class="reference-card partner-card">
    <h3>{content.partnerCompany.name}</h3>
    <a
      class="button button-secondary"
      href={content.partnerCompany.href}
      target="_blank"
      rel="noreferrer"
    >
      {content.partnerCompany.cta}
    </a>
  </article>
</section>

<style>
  .partner-section .section-heading {
    margin-bottom: 1.5rem;
  }

  .partner-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 2rem;
    border-radius: var(--radius-md);
    background: var(--partner-card-bg);
    border: 1px solid var(--partner-section-border);
    overflow: hidden;
  }

  .partner-card h3 {
    margin: 0;
    white-space: nowrap;
  }

  .partner-card .button {
    flex-shrink: 0;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .partner-card {
      flex-direction: column;
      align-items: stretch;
      padding: 1.25rem 1.5rem;
    }
  }
</style>
